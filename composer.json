{
    "name": "steuten-it-solutions/project-cockpit",
    "description": "Private management cockpit for all Steuten IT Solutions projects.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "chillerlan/php-qrcode": "^6.0",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "paragonie/constant_time_encoding": "^3.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Cockpit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cockpit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src public receiver cron config templates tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
