# Copy to .env for local development. On the server these are environment
# variables of the systemd service (see README.md); never commit real values.

# The same app_key as in the PHP cockpit's config/config.php.
NUXT_APP_KEY=
# mysql://user:password@host:3306/database
NUXT_DATABASE_URL=
# false only for local development over plain http.
NUXT_SECURE_COOKIES=true
