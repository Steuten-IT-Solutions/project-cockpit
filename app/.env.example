# Copy to .env for local development. On the server these are environment
# variables of the systemd service (see README.md); never commit real values.

# The same app_key as in the PHP cockpit's config/config.php.
NUXT_APP_KEY=
# mysql://user:password@host:3306/database
NUXT_DATABASE_URL=
# false only for local development over plain http.
NUXT_SECURE_COOKIES=true

# The remaining sections of config.php. A section is off while its first value is empty;
# server/lib/config.ts checks them with the same rules as the PHP cockpit.
NUXT_BASE_URL=https://cockpit.steuten-it-solutions.de
NUXT_TIMEZONE=Europe/Berlin
# Only for the first account (/setup?token=…); empty afterwards.
NUXT_SETUP_TOKEN=

# GitHub App (read-only). Accounts separated by commas.
NUXT_GITHUB_CLIENT_ID=
NUXT_GITHUB_PRIVATE_KEY_FILE=/etc/cockpit/github-app.pem
NUXT_GITHUB_ACCOUNTS=Steuten-IT-Solutions
NUXT_GITHUB_API_BASE=

# Vercel: token scoped to the team. NUXT_VERCEL_BILLING=false switches the charges off.
NUXT_VERCEL_TOKEN=
NUXT_VERCEL_TEAM_ID=
NUXT_VERCEL_BILLING=true

# Status reports of the company apps (receiver on the status subdomain).
NUXT_STATUS_REPORTS_ORG=

# Bug reports become issues in this repository.
NUXT_BUG_REPORTS_REPO=
NUXT_BUG_REPORTS_LABEL_PREFIX=kompanie:
NUXT_BUG_REPORTS_CLIENT_ID=
NUXT_BUG_REPORTS_PRIVATE_KEY_FILE=

# Releases of the company app template; the webhook secret (≥ 32 characters) enables POST /github.
NUXT_RELEASES_REPO=
NUXT_RELEASES_WEBHOOK_SECRET=

# Alert e-mails (sent with the server's sendmail) and web push (VAPID key file).
NUXT_ALERTS_EMAIL=
NUXT_ALERTS_FROM=Cockpit <noreply@steuten-it-solutions.de>
NUXT_PUSH_PRIVATE_KEY_FILE=
NUXT_PUSH_SUBJECT=
NUXT_MAIL_SENDMAIL=/usr/sbin/sendmail

# Folder with the SQL migrations (default: ../migrations next to the app).
NUXT_MIGRATIONS_DIR=

# false switches off the 15-minute background jobs (rehearsal on a copy of the database:
# otherwise it would send alert e-mails and create issues). The refresh button still works.
NUXT_SCHEDULED_JOBS=true

# Host name of the status subdomain; the receiver answers only requests for it.
NUXT_RECEIVER_HOST=status.steuten-it-solutions.de
